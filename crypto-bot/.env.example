# Copy to .env and fill in. .env is gitignored — NEVER commit real values.

# ---- LIVE TRADING ONLY (leave blank for paper mode) ----

# Path to a Solana keypair JSON file (array of 64 ints, e.g. exported from `solana-keygen`).
# Prefer a FILE over pasting the key here. This wallet should hold ONLY funds you can
# afford to lose 100% of. Do not point this at your main wallet.
SOLANA_KEYPAIR_PATH=

# Alternatively, a base58-encoded private key (less safe than a file). Use one or the other.
SOLANA_PRIVATE_KEY_BASE58=

# Solana RPC endpoint. The public one is rate-limited and unreliable for trading.
# Use a paid provider (Helius, QuickNode, Triton) for anything serious.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: a paid Jupiter endpoint if you have one (otherwise the public default is used).
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
